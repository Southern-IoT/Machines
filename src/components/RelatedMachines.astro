---
import { withBase, assetSrc } from "../lib/base";

interface Machine {
  title: string;
  subtitle?: string;
  brand: string;
  category: string;
  slug: string;
  machineImage?: string;
}

interface Props {
  currentSlug: string;
  currentBrand: string;
  currentCategory: string;
  machines: Machine[];
  limit?: number;
}

const { currentSlug, currentBrand, currentCategory, machines, limit = 3 } = Astro.props;

// Weight relevance: same brand is the strongest signal, then same category.
const scored = machines
  .filter(m => m.slug !== currentSlug)
  .map(m => ({
    ...m,
    score: (m.brand === currentBrand ? 2 : 0) + (m.category === currentCategory ? 1 : 0),
  }))
  .filter(m => m.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, limit);

if (scored.length === 0) return null;
---

<section style="background:#fff; border-radius:8px; border:1px solid #e3e6e6; padding:14px 18px;">
  <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px; padding-bottom:10px; border-bottom:1px solid #f0f0f0;">
    <span class="material-symbols-outlined notranslate" translate="no" style="font-size:15px; color:#ff9900;">hub</span>
    <h2 style="margin:0; font-size:11px; font-weight:700; color:#0f1111; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.06em;">Related Machines</h2>
  </div>
  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:10px;">
    {scored.map(m => {
      const imgSrc = assetSrc(m.machineImage);
      return (
        <a href={withBase(`/machines/${m.slug}/`)}
          style="display:flex; flex-direction:column; background:#f7f8f8; border:1px solid #e3e6e6; border-radius:6px; overflow:hidden; text-decoration:none; transition:border-color 0.15s, transform 0.15s;"
          onmouseover="this.style.borderColor='#ff9900'; this.style.transform='translateY(-1px)';"
          onmouseout="this.style.borderColor='#e3e6e6'; this.style.transform='translateY(0)';">
          {imgSrc ? (
            <div style="height:80px; background:#fff; display:flex; align-items:center; justify-content:center; padding:6px;">
              <img src={imgSrc} alt={m.title} loading="lazy" style="max-width:100%; max-height:100%; object-fit:contain; mix-blend-mode:multiply;" />
            </div>
          ) : (
            <div style="height:80px; background:#fff; display:flex; align-items:center; justify-content:center;">
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:28px; color:#ddd;">precision_manufacturing</span>
            </div>
          )}
          <div style="padding:8px 10px;">
            <div style="font-size:11px; font-weight:700; color:#0f1111; font-family:'Inter',sans-serif; line-height:1.3; overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; min-height:28px;">{m.title}</div>
            <div style="font-size:10px; color:#888; font-family:'Inter',sans-serif; margin-top:3px;">
              <span class="brand-text notranslate" translate="no" data-brand={m.brand}>{m.brand}</span> · {m.category}
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>
