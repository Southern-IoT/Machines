---
interface Props {
  items: { code: string; definition: string; action: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-4">
  <!-- Search input for error codes -->
  <div class="relative w-full max-w-md">
    <span
      class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2"
      style="color: var(--color-outline);"
    >
      search
    </span>
    <input
      class="w-full pl-10 pr-4 py-2 border border-outline-variant rounded bg-surface-container-lowest focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all text-body-md"
      style="color: var(--color-on-surface);"
      placeholder="Search error codes or symptoms..."
      type="text"
      id="maintenance-search"
    />
  </div>

  <div class="bg-surface-container-lowest border border-outline-variant rounded overflow-hidden">
    <table class="w-full text-left border-collapse" id="maintenance-table">
      <thead style="background-color: var(--color-secondary);">
        <tr>
          <th
            class="p-4 border-b border-outline-variant w-28 text-label-caps"
            style="color: var(--color-on-primary);"
          >
            Code
          </th>
          <th
            class="p-4 border-b border-outline-variant w-1/3 text-label-caps"
            style="color: var(--color-on-primary);"
          >
            Definition
          </th>
          <th
            class="p-4 border-b border-outline-variant text-label-caps"
            style="color: var(--color-on-primary);"
          >
            Corrective Action
          </th>
        </tr>
      </thead>
      <tbody class="text-body-md" style="color: var(--color-on-surface);">
        {
          items.map((item, i) => (
            <tr
              class="border-b border-outline-variant hover:bg-surface-container-low transition-colors maintenance-row"
              style={i % 2 === 0 ? "background-color: var(--color-surface-container-lowest);" : "background-color: var(--color-surface-container);"}
            >
              <td class="p-4 font-bold" style="color: var(--color-error);">
                {item.code}
              </td>
              <td class="p-4 font-semibold">{item.definition}</td>
              <td class="p-4" style="color: var(--color-on-surface-variant);">
                {item.action}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("maintenance-search") as HTMLInputElement;
    if (!searchInput) return;
    
    searchInput.addEventListener("input", () => {
      const query = searchInput.value.toLowerCase();
      const rows = document.querySelectorAll(".maintenance-row");
      rows.forEach((row) => {
        const text = (row as HTMLElement).textContent?.toLowerCase() || "";
        (row as HTMLElement).style.display = text.includes(query) ? "" : "none";
      });
    });
  });
</script>
