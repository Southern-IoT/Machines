---
interface Props {
  items: { code: string; definition: string; action: string }[];
}
const { items } = Astro.props;
---

<div style="display:flex; flex-direction:column; gap:10px;">
  <div style="position:relative; max-width:360px;">
    <span class="material-symbols-outlined notranslate" translate="no" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); font-size:16px; color:#999; pointer-events:none;">search</span>
    <input
      id="maintenance-search"
      type="text"
      placeholder="Search symptoms or error codes..."
      style="width:100%; padding:7px 12px 7px 32px; border:1px solid #e3e6e6; border-radius:6px; font-size:12px; font-family:'Inter',sans-serif; color:#0f1111; outline:none; background:#fff;"
      onfocus="this.style.borderColor='#ff9900'" onblur="this.style.borderColor='#e3e6e6'"
    />
  </div>

  <table id="maintenance-table" style="width:100%; border-collapse:collapse; font-size:12px; font-family:'Inter',sans-serif;">
    <thead>
      <tr style="background:#0f1111;">
        <th style="padding:8px 12px; text-align:left; font-weight:600; color:#ff9900; border-bottom:1px solid #2a2a2a; width:18%;">Symptom / Code</th>
        <th style="padding:8px 12px; text-align:left; font-weight:600; color:#ccc; border-bottom:1px solid #2a2a2a; width:40%;">Definition / Cause</th>
        <th style="padding:8px 12px; text-align:left; font-weight:600; color:#ccc; border-bottom:1px solid #2a2a2a;">Corrective Action</th>
      </tr>
    </thead>
    <tbody>
      {items.map((item, i) => (
        <tr class="maintenance-row" style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
          <td style="padding:7px 12px; font-weight:700; color:#c0392b; border-bottom:1px solid #f0f0f0; vertical-align:top;">{item.code}</td>
          <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0; vertical-align:top;">{item.definition}</td>
          <td style="padding:7px 12px; color:#565959; border-bottom:1px solid #f0f0f0; vertical-align:top;">{item.action}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const input = document.getElementById("maintenance-search") as HTMLInputElement;
    if (!input) return;
    input.addEventListener("input", () => {
      const q = input.value.toLowerCase();
      document.querySelectorAll(".maintenance-row").forEach(row => {
        (row as HTMLElement).style.display = (row.textContent || "").toLowerCase().includes(q) ? "" : "none";
      });
    });
  });
</script>
