---
// Renders a 2-column grid of key facts. Prefers technicalSpecs; falls back
// to classificationTable rows (mapped to {parameter, value} shape).
interface Props {
  machine: {
    technicalSpecs?: { parameter: string; value: string }[];
    classificationTable?: { field: string; value: string }[];
  };
  showHeader?: boolean;
}
const { machine, showHeader = true } = Astro.props;
const items = machine.technicalSpecs?.length
  ? machine.technicalSpecs.slice(0, 6)
  : (machine.classificationTable ?? []).slice(0, 6).map((r) => ({ parameter: r.field, value: r.value }));
---

{showHeader && items.length > 0 && (
  <div style="font-size:9px; font-weight:700; color:#999; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:8px;">Key Specifications</div>
)}
{items.length > 0 && (
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
    {items.map((item) => (
      <div style="background:#f7f8f8; border:1px solid #e3e6e6; border-radius:5px; padding:7px 10px;">
        <div style="font-size:9px; color:#999; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:2px;">{item.parameter}</div>
        <div style="font-size:11px; font-weight:600; color:#0f1111; font-family:'Inter',sans-serif; line-height:1.3;">{item.value}</div>
      </div>
    ))}
  </div>
)}
