---
import { withBase } from "../lib/base";
const homeHref = withBase("/");
---

<footer style="background:#0f1111; border-top:1px solid #2a2a2a; margin-top:auto;">
  <div style="max-width:1280px; margin:0 auto; padding:20px 24px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px;">
    <div style="display:flex; align-items:center; gap:8px;">
      <span class="material-symbols-outlined notranslate" translate="no" style="font-size:18px; color:#ff9900;">precision_manufacturing</span>
      <span class="logo-text notranslate" translate="no" data-en="Southern Machines" style="font-size:13px; font-weight:700; color:#ff9900; font-family:'Inter',sans-serif;">Southern Machines</span>
      <span style="font-size:12px; color:#666; font-family:'Inter',sans-serif; margin-left:8px;">© {new Date().getFullYear()} Factory Machine Database</span>
    </div>
    <div style="display:flex; gap:20px;">
      <a href={homeHref} style="font-size:12px; color:#999; font-family:'Inter',sans-serif; text-decoration:none;" onmouseover="this.style.color='#ff9900'" onmouseout="this.style.color='#999'">Inventory</a>
      <a href="#" style="font-size:12px; color:#999; font-family:'Inter',sans-serif; text-decoration:none;" onmouseover="this.style.color='#ff9900'" onmouseout="this.style.color='#999'">Contact Engineering</a>
    </div>
  </div>
</footer>
