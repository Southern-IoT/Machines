---
import { withBase } from "../lib/base";

interface Props {
  totalMachines: number;
  categories: string[];
  brands: string[];
  machines: { title: string; subtitle: string; brand: string; category: string; slug: string }[];
}

const { totalMachines, categories, brands, machines } = Astro.props;

// Serialize for client-side use
const machinesJson = JSON.stringify(machines);
const machinePathPrefix = withBase("/machines/");
---

<header
  class="border-b border-outline-variant py-20 relative overflow-hidden"
  style="background-color: var(--color-surface-container-lowest);"
>
  <!-- Decorative gradient overlay -->
  <div
    class="absolute right-0 top-0 w-1/3 h-full pointer-events-none opacity-[0.06]"
    style="background: linear-gradient(135deg, var(--color-primary), var(--color-primary-container));"
  >
  </div>

  <div class="container mx-auto px-5 md:px-16 max-w-7xl relative z-10">
    <div class="max-w-3xl mb-12 animate-fade-in">
      <h1 class="text-display-xl mb-2 tracking-tight" style="color: var(--color-on-surface);">
        Machinery Directory
      </h1>
      <p class="text-body-lg" style="color: var(--color-on-surface-variant);">
        Browse comprehensive technical specifications, working principles, and
        maintenance documentation across <strong>{totalMachines}</strong> factory
        machines.
      </p>
    </div>

    <!-- Search and Filter Bar -->
    <div
      class="p-6 border border-outline-variant rounded shadow-sm flex flex-col md:flex-row gap-4 items-end animate-slide-up delay-200"
      style="background-color: var(--color-surface);"
    >
      <div class="w-full flex-1">
        <label class="block text-label-caps mb-2" style="color: var(--color-on-surface-variant);">
          Search Database
        </label>
        <div class="relative" id="search-wrapper">
          <span
            class="material-symbols-outlined notranslate absolute left-4 top-1/2 -translate-y-1/2 z-10"
            translate="no"
            style="color: var(--color-outline);"
          >
            search
          </span>
          <input
            class="w-full pl-12 pr-4 py-2.5 bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded text-body-md transition-colors"
            style="color: var(--color-on-surface);"
            placeholder="Enter Model, Brand, or Keyword..."
            type="text"
            id="search-input"
            autocomplete="off"
          />
        </div>
      </div>

      <div class="w-full md:w-48">
        <label class="block text-label-caps mb-2" style="color: var(--color-on-surface-variant);">
          Manufacturer
        </label>
        <select
          class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded text-body-md transition-colors"
          style="color: var(--color-on-surface);"
          id="brand-filter"
        >
          <option value="">All Brands</option>
          {brands.map((brand) => <option value={brand} class="notranslate brand-option" translate="no" data-brand={brand}>{brand}</option>)}
        </select>
      </div>

      <div class="w-full md:w-48">
        <label class="block text-label-caps mb-2" style="color: var(--color-on-surface-variant);">
          Category
        </label>
        <select
          class="w-full px-4 py-2.5 bg-surface-container-lowest border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded text-body-md transition-colors"
          style="color: var(--color-on-surface);"
          id="category-filter"
        >
          <option value="">All Categories</option>
          {
            categories.map((cat) => (
              <option value={cat}>{cat}</option>
            ))
          }
        </select>
      </div>

      <button
        class="w-full md:w-auto px-12 py-2.5 rounded text-label-caps uppercase whitespace-nowrap h-[42px] flex items-center justify-center gap-2 transition-colors hover:opacity-90"
        style="background-color: var(--color-primary); color: var(--color-on-primary);"
        id="filter-btn"
      >
        <span class="material-symbols-outlined notranslate text-lg" translate="no">filter_list</span>
        Filter
      </button>
    </div>
  </div>
</header>

<!-- Dropdown rendered at body level to escape all overflow:hidden ancestors -->
<ul
  id="search-dropdown"
  style="
    display: none;
    position: fixed;
    z-index: 9999;
    background-color: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant);
    border-radius: 0.25rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    overflow: hidden;
    max-height: 360px;
    overflow-y: auto;
  "
>
</ul>

<script define:vars={{ machinesJson, machinePathPrefix }}>
  const machines = JSON.parse(machinesJson);
  const input = document.getElementById("search-input");
  const wrapper = document.getElementById("search-wrapper");
  const dropdown = document.getElementById("search-dropdown");

  function positionDropdown() {
    const rect = wrapper.getBoundingClientRect();
    dropdown.style.top = (rect.bottom + window.scrollY) + "px";
    dropdown.style.left = (rect.left + window.scrollX) + "px";
    dropdown.style.width = rect.width + "px";
  }

  function highlight(text, query) {
    if (!query) return text;
    const idx = text.toLowerCase().indexOf(query.toLowerCase());
    if (idx === -1) return text;
    return (
      text.slice(0, idx) +
      `<mark style="background-color:var(--color-primary-container);color:var(--color-on-primary-container);border-radius:2px;">` +
      text.slice(idx, idx + query.length) +
      `</mark>` +
      text.slice(idx + query.length)
    );
  }

  function showDropdown(query) {
    if (!query) {
      dropdown.style.display = "none";
      dropdown.innerHTML = "";
      return;
    }

    const q = query.toLowerCase();
    const matches = machines.filter((m) =>
      [m.title, m.subtitle, m.brand, m.category].join(" ").toLowerCase().includes(q)
    );

    if (matches.length === 0) {
      dropdown.innerHTML = `<li style="padding:12px 16px;font-size:14px;color:var(--color-outline);">No results for "${query}"</li>`;
    } else {
      dropdown.innerHTML = matches
        .slice(0, 8)
        .map(
          (m) => `
          <li>
            <a
              href="${machinePathPrefix}${m.slug}/"
              style="display:flex;align-items:center;gap:12px;padding:10px 16px;text-decoration:none;transition:background 0.15s;"
              onmouseover="this.style.backgroundColor='var(--color-surface-container)'"
              onmouseout="this.style.backgroundColor=''"
            >
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:18px;color:var(--color-outline);flex-shrink:0;">precision_manufacturing</span>
              <div style="min-width:0;">
                <div style="font-size:14px;font-weight:500;color:var(--color-on-surface);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${highlight(m.title, query)}</div>
                <div style="font-size:11px;color:var(--color-outline);font-family:'JetBrains Mono',monospace;letter-spacing:0.05em;"><span class="brand-text notranslate" translate="no" data-brand="${m.brand}">${m.brand}</span> · ${m.category}</div>
              </div>
            </a>
          </li>`
        )
        .join("");
    }

    positionDropdown();
    dropdown.style.display = "block";
    if (window.runBrandTranslationUpdate) {
      window.runBrandTranslationUpdate();
    }
  }

  input?.addEventListener("input", (e) => {
    showDropdown(e.target.value.trim());
  });

  input?.addEventListener("focus", (e) => {
    if (e.target.value.trim()) showDropdown(e.target.value.trim());
  });

  // Reposition on scroll/resize
  window.addEventListener("scroll", () => {
    if (dropdown.style.display !== "none") positionDropdown();
  });
  window.addEventListener("resize", () => {
    if (dropdown.style.display !== "none") positionDropdown();
  });

  // Close on outside click
  document.addEventListener("click", (e) => {
    if (!wrapper?.contains(e.target) && !dropdown?.contains(e.target)) {
      dropdown.style.display = "none";
    }
  });

  input?.addEventListener("keydown", (e) => {
    if (e.key === "Escape") dropdown.style.display = "none";
  });
</script>
