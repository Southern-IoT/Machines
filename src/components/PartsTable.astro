---
interface Part {
  partName: string;
  partId: string;
  section?: string;
  function: string;
}

interface Props {
  parts: Part[];
}

const { parts } = Astro.props;

const mechanical = parts.filter(p => !p.section || p.section === "mechanical");
const electronic = parts.filter(p => p.section === "electronic");
const hasSections = electronic.length > 0;

const tableStyle = "width:100%; border-collapse:collapse; font-size:12px; font-family:'Inter',sans-serif;";
const thStyle = "padding:7px 12px; text-align:left; font-weight:600; color:#565959; border-bottom:1px solid #e3e6e6; font-size:11px; text-transform:uppercase; letter-spacing:0.04em;";
const tdNameStyle = "padding:7px 12px; font-weight:600; color:#0f1111; border-bottom:1px solid #f0f0f0; font-size:12px;";
const tdIdStyle = "padding:7px 12px; color:#888; border-bottom:1px solid #f0f0f0; font-size:11px; font-family:'JetBrains Mono',monospace;";
const tdFnStyle = "padding:7px 12px; color:#565959; border-bottom:1px solid #f0f0f0; font-size:12px; line-height:1.4;";
---

<div style="display:flex; flex-direction:column; gap:16px;">

  {hasSections ? (
    <>
      {mechanical.length > 0 && (
        <div>
          <div style="font-size:11px; font-weight:700; color:#ff9900; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px; padding-left:2px;">
            Main Mechanical Parts
          </div>
          <div style="border:1px solid #e3e6e6; border-radius:6px; overflow:hidden;">
            <table style={tableStyle}>
              <thead>
                <tr style="background:#f7f8f8;">
                  <th style={thStyle + "width:35%;"}>Part Name</th>
                  <th style={thStyle + "width:15%;"}>Component ID</th>
                  <th style={thStyle}>Function</th>
                </tr>
              </thead>
              <tbody>
                {mechanical.map((part, i) => (
                  <tr style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
                    <td style={tdNameStyle}>{part.partName}</td>
                    <td style={tdIdStyle}>{part.partId || "—"}</td>
                    <td style={tdFnStyle}>{part.function}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {electronic.length > 0 && (
        <div>
          <div style="font-size:11px; font-weight:700; color:#ff9900; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:8px; padding-left:2px;">
            Electronic Boards and Control Parts
          </div>
          <div style="border:1px solid #e3e6e6; border-radius:6px; overflow:hidden;">
            <table style={tableStyle}>
              <thead>
                <tr style="background:#f7f8f8;">
                  <th style={thStyle + "width:35%;"}>Factory Name</th>
                  <th style={thStyle + "width:15%;"}>Official / Technical Name</th>
                  <th style={thStyle}>Function</th>
                </tr>
              </thead>
              <tbody>
                {electronic.map((part, i) => (
                  <tr style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
                    <td style={tdNameStyle}>{part.partName}</td>
                    <td style={tdIdStyle}>{part.partId || "—"}</td>
                    <td style={tdFnStyle}>{part.function}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </>
  ) : (
    <div style="border:1px solid #e3e6e6; border-radius:6px; overflow:hidden;">
      <table style={tableStyle}>
        <thead>
          <tr style="background:#f7f8f8;">
            <th style={thStyle + "width:35%;"}>Part Name</th>
            <th style={thStyle + "width:15%;"}>Component ID</th>
            <th style={thStyle}>Function</th>
          </tr>
        </thead>
        <tbody>
          {parts.map((part, i) => (
            <tr style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
              <td style={tdNameStyle}>{part.partName}</td>
              <td style={tdIdStyle}>{part.partId || "—"}</td>
              <td style={tdFnStyle}>{part.function}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

</div>
