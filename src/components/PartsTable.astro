---
interface Part {
  partName: string;
  partId: string;
  section?: string;
  function: string;
}

interface Props {
  parts: Part[];
}

const { parts } = Astro.props;

const mechanical = parts.filter(p => !p.section || p.section === "mechanical");
const electronic = parts.filter(p => p.section === "electronic");
const hasSections = electronic.length > 0;
---

<div class="flex flex-col gap-6">

  {hasSections ? (
    <>
      <!-- Main Mechanical Parts -->
      {mechanical.length > 0 && (
        <div>
          <h3 class="text-body-lg font-semibold mb-3 px-1" style="color: var(--color-secondary);">
            Main Mechanical Parts
          </h3>
          <div class="bg-surface-container-lowest border border-outline-variant rounded overflow-hidden">
            <table class="w-full text-left border-collapse">
              <thead style="background-color: var(--color-surface-container);">
                <tr>
                  <th class="p-4 border-b border-outline-variant w-48 text-label-caps" style="color: var(--color-on-surface-variant);">Part Name</th>
                  <th class="p-4 border-b border-outline-variant w-32 text-label-caps" style="color: var(--color-on-surface-variant);">Component ID</th>
                  <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-surface-variant);">Function</th>
                </tr>
              </thead>
              <tbody class="text-body-md" style="color: var(--color-on-surface);">
                {mechanical.map((part, i) => (
                  <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors"
                    style={i % 2 === 0 ? "background-color: var(--color-surface-container-lowest);" : "background-color: var(--color-surface-container);"}>
                    <td class="p-4 font-semibold">{part.partName}</td>
                    <td class="p-4" style="font-family: var(--font-label); color: var(--color-secondary);">{part.partId || "—"}</td>
                    <td class="p-4" style="color: var(--color-on-surface-variant);">{part.function}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      <!-- Electronic Boards and Control Parts -->
      {electronic.length > 0 && (
        <div>
          <h3 class="text-body-lg font-semibold mb-3 px-1" style="color: var(--color-secondary);">
            Electronic Boards and Control Parts
          </h3>
          <div class="bg-surface-container-lowest border border-outline-variant rounded overflow-hidden">
            <table class="w-full text-left border-collapse">
              <thead style="background-color: var(--color-surface-container);">
                <tr>
                  <th class="p-4 border-b border-outline-variant w-48 text-label-caps" style="color: var(--color-on-surface-variant);">Factory Name</th>
                  <th class="p-4 border-b border-outline-variant w-32 text-label-caps" style="color: var(--color-on-surface-variant);">Official / Technical Name</th>
                  <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-surface-variant);">Function</th>
                </tr>
              </thead>
              <tbody class="text-body-md" style="color: var(--color-on-surface);">
                {electronic.map((part, i) => (
                  <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors"
                    style={i % 2 === 0 ? "background-color: var(--color-surface-container-lowest);" : "background-color: var(--color-surface-container);"}>
                    <td class="p-4 font-semibold">{part.partName}</td>
                    <td class="p-4" style="font-family: var(--font-label); color: var(--color-secondary);">{part.partId || "—"}</td>
                    <td class="p-4" style="color: var(--color-on-surface-variant);">{part.function}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </>
  ) : (
    <!-- Single table — no section split -->
    <div class="bg-surface-container-lowest border border-outline-variant rounded overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead style="background-color: var(--color-surface-container);">
          <tr>
            <th class="p-4 border-b border-outline-variant w-48 text-label-caps" style="color: var(--color-on-surface-variant);">Part Name</th>
            <th class="p-4 border-b border-outline-variant w-32 text-label-caps" style="color: var(--color-on-surface-variant);">Component ID</th>
            <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-surface-variant);">Function</th>
          </tr>
        </thead>
        <tbody class="text-body-md" style="color: var(--color-on-surface);">
          {parts.map((part, i) => (
            <tr class="border-b border-outline-variant hover:bg-surface-container-low transition-colors"
              style={i % 2 === 0 ? "background-color: var(--color-surface-container-lowest);" : "background-color: var(--color-surface-container);"}>
              <td class="p-4 font-semibold">{part.partName}</td>
              <td class="p-4" style="font-family: var(--font-label); color: var(--color-secondary);">{part.partId || "—"}</td>
              <td class="p-4" style="color: var(--color-on-surface-variant);">{part.function}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

</div>
