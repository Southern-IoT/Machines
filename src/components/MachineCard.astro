---
interface Props {
  title: string;
  subtitle: string;
  brand: string;
  category: string;
  image?: string;
  slug: string;
  specs?: { label: string; value: string }[];
  searchData?: string;
}

const { title, subtitle, brand, category, image, slug, specs = [], searchData = "" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Fix image path for base URL (e.g. /uploads/x.jpg → /Machines/uploads/x.jpg)
const imageSrc = image && image.startsWith("/") ? `${base}${image}` : image;
---

<a
  href={`${base}/machines/${slug}/`}
  id={`machine-card-${slug}`}
  data-brand={brand.toLowerCase()}
  data-category={category.toLowerCase()}
  data-search={searchData}
  style="display:flex; flex-direction:column; background:#fff; border:1px solid #e3e6e6; border-radius:8px; overflow:hidden; text-decoration:none; transition:box-shadow 0.15s, border-color 0.15s; cursor:pointer;"
  onmouseover="this.style.boxShadow='0 4px 20px rgba(0,0,0,0.1)'; this.style.borderColor='#ff9900';"
  onmouseout="this.style.boxShadow='none'; this.style.borderColor='#e3e6e6';"
>
  <!-- Image area -->
  <div style="height:150px; background:#f7f8f8; border-bottom:1px solid #e3e6e6; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; padding:12px;">
    {imageSrc ? (
      <img
        src={imageSrc}
        alt={title}
        loading="lazy"
        style="width:100%; height:100%; object-fit:contain; mix-blend-mode:multiply;"
      />
    ) : (
      <div style="display:flex; flex-direction:column; align-items:center; gap:6px; color:#bbb;">
        <span class="material-symbols-outlined" style="font-size:42px; color:#ddd;">precision_manufacturing</span>
        <span style="font-size:10px; font-family:'Inter',sans-serif; color:#bbb; letter-spacing:0.04em; text-transform:uppercase;">{category}</span>
      </div>
    )}
    <!-- Brand badge -->
    <div style="position:absolute; top:8px; right:8px; background:#0f1111; color:#ff9900; font-size:10px; font-weight:700; font-family:'Inter',sans-serif; padding:2px 8px; border-radius:4px; letter-spacing:0.04em;">
      {brand}
    </div>
  </div>

  <!-- Body -->
  <div style="padding:12px 14px 14px; display:flex; flex-direction:column; gap:4px; flex:1;">
    <h3 style="margin:0; font-size:13px; font-weight:700; color:#0f1111; font-family:'Inter',sans-serif; line-height:1.4; overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2;">
      {title}
    </h3>
    <p style="margin:0; font-size:12px; color:#565959; font-family:'Inter',sans-serif; line-height:1.5; overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; flex:1;">
      {subtitle}
    </p>

    <!-- Category tag -->
    <div style="margin-top:4px;">
      <span style="display:inline-block; background:#f0f2f2; color:#565959; font-size:10px; font-family:'Inter',sans-serif; padding:2px 8px; border-radius:4px; border:1px solid #e3e6e6;">
        {category}
      </span>
    </div>

    {specs.length > 0 && (
      <div style="margin-top:8px; padding-top:8px; border-top:1px solid #f0f0f0; display:grid; grid-template-columns:1fr 1fr; gap:6px;">
        {specs.slice(0, 2).map(spec => (
          <div>
            <div style="font-size:9px; font-family:'Inter',sans-serif; color:#999; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:1px;">{spec.label}</div>
            <div style="font-size:11px; font-weight:600; color:#0f1111; font-family:'Inter',sans-serif; line-height:1.3;">{spec.value}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</a>
