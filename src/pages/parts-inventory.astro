---
// /parts-inventory — Browse semantic concepts and click-to-upload images
// to the parts library. Auto-generated by `npm run scan-parts`.
//
// This page is for the maintainer (not the public site). It reads the
// generated JSON in src/content/parts-inventory/ and shows one row per
// concept, with filters for status, type (generic vs brand-scoped), and
// search by concept name or machine slug.
//
// Click-through: "Add image" opens the TinaCMS partsLibrary new-entry form
// at /admin/#/~partsLibrary/new with key/brand/partName pre-filled.

import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { loadAllMachines, getBuildTimestamp, formatLastUpdated } from "../lib/machines";
import { buildPartsLibraryNewUrl } from "../lib/parts-library";

const INVENTORY_DIR = path.join(process.cwd(), "src/content/parts-inventory");

interface InventoryEntry {
  key: string;
  type: "generic" | "brand-scoped";
  label: string;
  brand: string | null;
  machines: string[];
  occurrences: number;
  hasImage: boolean;
  sampleNames: string[];
  newUrl?: string;
}

let inventory: InventoryEntry[] = [];
let parseErrors: string[] = [];
if (fs.existsSync(INVENTORY_DIR)) {
  const files = fs.readdirSync(INVENTORY_DIR).filter((f) => f.endsWith(".json"));
  for (const f of files) {
    try {
      const raw = fs.readFileSync(path.join(INVENTORY_DIR, f), "utf-8");
      const entry = JSON.parse(raw) as InventoryEntry;
      inventory.push(entry);
    } catch (err) {
      parseErrors.push(f);
    }
  }
}

// Sort: pending first, then by occurrences desc
inventory.sort((a, b) => {
  if (a.hasImage !== b.hasImage) return a.hasImage ? 1 : -1;
  return b.occurrences - a.occurrences;
});

const totals = {
  total: inventory.length,
  pending: inventory.filter((e) => !e.hasImage).length,
  uploaded: inventory.filter((e) => e.hasImage).length,
  generic: inventory.filter((e) => e.type === "generic").length,
  brandScoped: inventory.filter((e) => e.type === "brand-scoped").length,
};

// Build a slug -> title map so we can show machine names instead of slugs
const allMachines = loadAllMachines();
const machineTitleBySlug: Record<string, string> = {};
for (const m of allMachines) {
  machineTitleBySlug[m.slug] = m.title;
}

// Surface the build moment as a "Last updated" stamp in the header
// (mirrors the homepage). Captured at build time — every deploy advances it.
const lastUpdatedLabel = formatLastUpdated(getBuildTimestamp());

// Pre-compute the TinaCMS deep-link for each entry on the server (the helper
// uses `import.meta.env.BASE_URL` which is only available at build time, so
// we can't reconstruct it on the client).
for (const entry of inventory) {
  entry.newUrl = buildPartsLibraryNewUrl({
    key: entry.key,
    brand: entry.brand || undefined,
    partName: entry.label,
  });
}

// Pre-serialize for the client filter script
const inventoryJson = JSON.stringify(inventory);
const titleMapJson = JSON.stringify(machineTitleBySlug);
const totalsJson = JSON.stringify(totals);

const navMachines = allMachines.map((m) => ({
  title: m.title,
  subtitle: m.subtitle || "",
  brand: m.brand || "",
  category: m.category || "",
  slug: m.slug,
}));
---

<BaseLayout title="Parts Inventory — Pending Images">
  <Navbar currentPage="parts-inventory" machines={navMachines} />

  <main style="background:#f7f8f8; min-height:calc(100vh - 56px);">
    <div style="max-width:1280px; margin:0 auto; padding:20px 24px 40px;">

      <!-- Page header -->
      <div style="display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid #e3e6e6; flex-wrap:wrap; gap:12px;">
        <div>
          <h1 style="margin:0; font-size:17px; font-weight:700; color:#0f1111; font-family:'Inter',sans-serif;">Parts Inventory — Pending Images</h1>
          <p style="margin:3px 0 0; font-size:12px; color:#565959; font-family:'Inter',sans-serif;">
            Semantic concepts deduplicated across machines. Click <strong>Add image</strong> to upload a photo — it serves every machine using that part.
          </p>
        </div>
        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:4px;">
          <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end;">
            <span style="font-size:12px; color:#565959; font-family:'Inter',sans-serif; background:#fff; padding:4px 12px; border-radius:20px; border:1px solid #e3e6e6;">
              <strong style="color:#0f1111;">{totals.total}</strong> concepts
            </span>
            <span style="font-size:12px; color:#a85b00; font-family:'Inter',sans-serif; background:#fff7eb; padding:4px 12px; border-radius:20px; border:1px solid #ffd9a3;">
              <strong>{totals.pending}</strong> pending
            </span>
            <span style="font-size:12px; color:#1a7f37; font-family:'Inter',sans-serif; background:#f0f9f3; padding:4px 12px; border-radius:20px; border:1px solid #b6e5c4;">
              <strong>{totals.uploaded}</strong> uploaded
            </span>
          </div>
          {lastUpdatedLabel && (
            <span style="font-size:11px; color:#888; font-family:'Inter',sans-serif; display:inline-flex; align-items:center; gap:4px;">
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:12px; color:#888;">schedule</span>
              Last updated: {lastUpdatedLabel}
            </span>
          )}
        </div>
      </div>

      <!-- Filter / search bar -->
      <div style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:14px; padding:12px 14px; background:#fff; border:1px solid #e3e6e6; border-radius:8px; align-items:center;">
        <div style="position:relative; flex:1; min-width:220px;">
          <span class="material-symbols-outlined notranslate" translate="no" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); font-size:18px; color:#888; pointer-events:none;">search</span>
          <input
            id="inv-search"
            type="text"
            autocomplete="off"
            placeholder="Search concept, machine, or sample part name..."
            style="width:100%; padding:7px 12px 7px 36px; background:#fafafa; border:1.5px solid #e0e0e0; border-radius:6px; font-size:13px; color:#111; font-family:'Inter',sans-serif; outline:none;"
          />
        </div>
        <select id="filter-status" style="padding:7px 10px; background:#fff; color:#0f1111; border:1.5px solid #e0e0e0; border-radius:6px; font-size:13px; font-family:'Inter',sans-serif; cursor:pointer;">
          <option value="pending">Pending only</option>
          <option value="uploaded">Uploaded only</option>
          <option value="all">All</option>
        </select>
        <select id="filter-type" style="padding:7px 10px; background:#fff; color:#0f1111; border:1.5px solid #e0e0e0; border-radius:6px; font-size:13px; font-family:'Inter',sans-serif; cursor:pointer;">
          <option value="all">All types</option>
          <option value="generic">Generic (shared across brands)</option>
          <option value="brand-scoped">Brand-scoped</option>
        </select>
        <button id="reset-filters" style="padding:7px 12px; background:#f0f0f0; color:#0f1111; border:1.5px solid #e0e0e0; border-radius:6px; font-size:13px; font-family:'Inter',sans-serif; cursor:pointer;"
          onmouseover="this.style.background='#e0e0e0'" onmouseout="this.style.background='#f0f0f0'">
          Reset
        </button>
      </div>

      <!-- Concept table -->
      {parseErrors.length > 0 && (
        <div style="background:#fff3cd; border:1px solid #ffc107; border-radius:8px; padding:12px 16px; margin-bottom:14px; font-size:13px; color:#7a5d00; font-family:'Inter',sans-serif;">
          <strong>Warning:</strong> Failed to parse {parseErrors.length} inventory file(s): {parseErrors.join(", ")}. Run <code>npm run scan-parts</code> to regenerate.
        </div>
      )}

      {inventory.length === 0 ? (
        <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:60px 24px; background:#fff; border:1.5px dashed #e3e6e6; border-radius:8px;">
          <span class="material-symbols-outlined notranslate" translate="no" style="font-size:40px; color:#ccc; margin-bottom:12px;">inventory_2</span>
          <p style="margin:0 0 4px; font-size:15px; font-weight:600; color:#0f1111; font-family:'Inter',sans-serif;">No Inventory Yet</p>
          <p style="margin:0 0 12px; font-size:13px; color:#565959; font-family:'Inter',sans-serif;">Run <code>npm run scan-parts</code> to generate concept inventory from your machine parts lists.</p>
        </div>
      ) : (
        <div id="inv-table-wrapper" style="background:#fff; border:1px solid #e3e6e6; border-radius:8px; overflow:hidden;">
          <div style="display:grid; grid-template-columns:1.4fr 0.7fr 0.7fr 1.4fr 0.7fr 0.8fr; padding:10px 14px; background:#fafafa; border-bottom:1px solid #e3e6e6; font-size:11px; font-weight:700; color:#565959; text-transform:uppercase; letter-spacing:0.5px; font-family:'Inter',sans-serif;">
            <div>Concept</div>
            <div>Type</div>
            <div>Brand</div>
            <div>Used in</div>
            <div style="text-align:right;">Occurrences</div>
            <div style="text-align:right;">Action</div>
          </div>
          <div id="inv-rows"></div>
        </div>
      )}

      <div id="inv-empty" style="display:none; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:40px 24px; background:#fff; border:1.5px dashed #e3e6e6; border-radius:8px; margin-top:14px;">
        <span class="material-symbols-outlined notranslate" translate="no" style="font-size:36px; color:#ccc; margin-bottom:8px;">search_off</span>
        <p style="margin:0; font-size:14px; font-weight:600; color:#0f1111; font-family:'Inter',sans-serif;">No concepts match your filters</p>
      </div>

      <!-- Helper: how to regenerate -->
      <details style="margin-top:24px; background:#fff; border:1px solid #e3e6e6; border-radius:8px; padding:0;">
        <summary style="padding:12px 16px; cursor:pointer; font-size:13px; font-weight:600; color:#0f1111; font-family:'Inter',sans-serif; list-style:none; display:flex; align-items:center; gap:8px;">
          <span class="material-symbols-outlined notranslate" translate="no" style="font-size:18px; color:#888;">info</span>
          How to use this page
        </summary>
        <div style="padding:0 16px 16px; font-size:13px; color:#565959; font-family:'Inter',sans-serif; line-height:1.7;">
          <ol style="margin:0; padding-left:18px;">
            <li>Click <strong>Add image</strong> on any pending concept. It opens TinaCMS with <code>key</code> + <code>brand</code> pre-filled.</li>
            <li>Drop your image into the upload field and save.</li>
            <li>After saving, run <code>npm run scan-parts</code> — the entry will be marked as <strong>uploaded</strong> and disappear from the default view.</li>
            <li>For <strong>generic</strong> concepts (needles, bearings, belts), one image serves every machine that uses that part.</li>
            <li>For <strong>brand-scoped</strong> concepts (bobbin, looper), each brand needs its own image (different part numbers / geometry).</li>
          </ol>
          <p style="margin:12px 0 4px; padding:8px 12px; background:#fffbf2; border-left:3px solid #ff9900; border-radius:0 4px 4px 0; font-size:12px;">
            <strong>Local dev note:</strong> the <strong>Add image</strong> button links to <code>http://localhost:4001/admin/...</code> — TinaCMS's own dev server.
            Start it with <code>npm run cms</code> (runs Astro + TinaCMS together). If you only ran <code>npm run dev</code> (Astro only), start a second terminal with <code>npx tinacms dev</code> on port 4001.
            On the deployed site, the same link points to <code>/Machines/admin/</code>.
          </p>
          <p style="margin:8px 0 0;">Edit concept taxonomy in <code>src/lib/concepts.ts</code>.</p>
        </div>
      </details>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ inventoryJson, titleMapJson, totalsJson }}>
  const inventory = JSON.parse(inventoryJson);
  const titleMap = JSON.parse(titleMapJson);
  const totals = JSON.parse(totalsJson);
  const rowsEl = document.getElementById("inv-rows");
  const emptyEl = document.getElementById("inv-empty");
  const search = document.getElementById("inv-search");
  const filterStatus = document.getElementById("filter-status");
  const filterType = document.getElementById("filter-type");
  const resetBtn = document.getElementById("reset-filters");

  function escapeHtml(s) {
    if (s == null) return "";
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function machineList(machines, max = 3) {
    const shown = machines.slice(0, max);
    const rest = machines.length - shown.length;
    const links = shown.map(slug => {
      const t = titleMap[slug] || slug;
      return `<span style="color:#0f1111;">${escapeHtml(t)}</span>`;
    }).join(", ");
    return links + (rest > 0 ? ` <span style="color:#888;">+${rest} more</span>` : "");
  }

  function buildTinaUrl(entry) {
    // Pre-computed on the server (see frontmatter) — the URL helper uses
    // `import.meta.env.BASE_URL` which is only available at build time.
    return entry.newUrl || "#";
  }

  function render() {
    const q = (search?.value || "").toLowerCase().trim();
    const status = filterStatus?.value || "pending";
    const type = filterType?.value || "all";

    const filtered = inventory.filter(e => {
      if (status === "pending" && e.hasImage) return false;
      if (status === "uploaded" && !e.hasImage) return false;
      if (type !== "all" && e.type !== type) return false;
      if (q) {
        const hay = [
          e.label, e.key, e.brand || "", e.type,
          ...(e.machines || []),
          ...(e.sampleNames || [])
        ].join(" ").toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
      rowsEl.innerHTML = "";
      emptyEl.style.display = "flex";
    } else {
      emptyEl.style.display = "none";
      rowsEl.innerHTML = filtered.map((e, i) => {
        const typeColor = e.type === "generic" ? "#1a7f37" : "#a85b00";
        const typeBg = e.type === "generic" ? "#f0f9f3" : "#fff7eb";
        const typeBorder = e.type === "generic" ? "#b6e5c4" : "#ffd9a3";
        const brand = e.brand || "—";
        const isUploaded = e.hasImage;
        const rowBg = isUploaded ? "#f8fdf9" : (i % 2 === 0 ? "#fff" : "#fbfcfd");
        const actionBtn = isUploaded
          ? `<span style="font-size:11px; color:#1a7f37; font-weight:600; font-family:'Inter',sans-serif; display:inline-flex; align-items:center; gap:4px;">
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:16px;">check_circle</span> Done
            </span>`
          : `<a href="${buildTinaUrl(e)}" target="_blank" rel="noopener"
              style="display:inline-flex; align-items:center; gap:4px; padding:5px 10px; background:#ff9900; color:#0f1111; text-decoration:none; border-radius:5px; font-size:12px; font-weight:600; font-family:'Inter',sans-serif;"
              onmouseover="this.style.background='#e68a00'" onmouseout="this.style.background='#ff9900'">
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:14px;">add_photo_alternate</span> Add image
            </a>`;
        return `<div style="display:grid; grid-template-columns:1.4fr 0.7fr 0.7fr 1.4fr 0.7fr 0.8fr; padding:10px 14px; background:${rowBg}; border-bottom:1px solid #f0f0f0; align-items:center; font-size:13px; font-family:'Inter',sans-serif;">
          <div>
            <div style="font-weight:600; color:#0f1111;">${escapeHtml(e.label)}</div>
            <div style="font-size:11px; color:#888; font-family:'JetBrains Mono',monospace; margin-top:2px;">${escapeHtml(e.key)}</div>
          </div>
          <div>
            <span style="display:inline-block; padding:2px 8px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; color:${typeColor}; background:${typeBg}; border:1px solid ${typeBorder}; border-radius:10px;">
              ${escapeHtml(e.type)}
            </span>
          </div>
          <div style="color:#0f1111; font-weight:500;">${escapeHtml(brand)}</div>
          <div style="color:#565959; font-size:12px; line-height:1.5;">${machineList(e.machines)}</div>
          <div style="text-align:right; color:#0f1111; font-weight:600;">${e.occurrences}× <span style="color:#888; font-weight:400; font-size:11px;">(${e.machines.length} machines)</span></div>
          <div style="text-align:right;">${actionBtn}</div>
        </div>`;
      }).join("");
    }
  }

  search?.addEventListener("input", render);
  filterStatus?.addEventListener("change", render);
  filterType?.addEventListener("change", render);
  resetBtn?.addEventListener("click", () => {
    if (search) search.value = "";
    if (filterStatus) filterStatus.value = "pending";
    if (filterType) filterType.value = "all";
    render();
  });

  render();
</script>
