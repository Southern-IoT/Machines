---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import SectionCard from "../../components/SectionCard.astro";
import SpecTable from "../../components/SpecTable.astro";
import SequenceFlow from "../../components/SequenceFlow.astro";
import PartsTable from "../../components/PartsTable.astro";
import MaintenanceTable from "../../components/MaintenanceTable.astro";
import RelatedMachines from "../../components/RelatedMachines.astro";
import KeySpecsGrid from "../../components/KeySpecsGrid.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { withBase, assetSrc } from "../../lib/base";
import { loadMachineSummaries } from "../../lib/machines";
import fs from "node:fs";
import path from "node:path";

const allMachines = loadMachineSummaries();

// getStaticPaths runs in a separate module context, so the machine
// directory path must be resolved inline rather than imported.
export function getStaticPaths() {
  const dir = path.join(process.cwd(), "src/content/machines");
  if (!fs.existsSync(dir)) return [];
  const files = fs.readdirSync(dir).filter((f: string) => f.endsWith(".json"));
  return files.map((file: string) => {
    const raw = fs.readFileSync(path.join(dir, file), "utf-8");
    return { params: { slug: file.replace(".json", "") }, props: { machine: JSON.parse(raw) } };
  });
}

const { machine } = Astro.props;
const homeHref = withBase("/");
const machineImageSrc = assetSrc(machine.machineImage);
const hasGaugeParts = Array.isArray(machine.gaugePartsCrossReference) && machine.gaugePartsCrossReference.length > 0;

// "More Information Coming Soon" banner: shown when at least one of the
// major post-technical-data content sections is missing. This signals to
// visitors that the page is a work-in-progress rather than fully complete.
const isIncomplete =
  !(machine.workingPrinciples?.length) ||
  !(machine.sequenceFlow?.length) ||
  !(machine.partsList?.length) ||
  !(machine.maintenance?.length);

const sections = [
  { id: "purpose",          label: "Purpose & Application",       icon: "target",         show: !!machine.purposeAndApplication },
  { id: "overview",         label: "Machine Overview",            icon: "info",           show: true },
  { id: "technical-data",   label: "Technical Data",              icon: "settings",       show: !!machine.technicalSpecs?.length },
  { id: "working-principle",label: "Working Principle",           icon: "psychology",     show: !!machine.workingPrinciples?.length },
  { id: "sequence-flow",    label: "Operational Sequence",         icon: "account_tree",   show: !!machine.sequenceFlow?.length },
  { id: "parts-list",       label: "Parts List",                  icon: "build",          show: !!machine.partsList?.length },
  { id: "gauge-parts",      label: "Gauge / Parts Cross Reference", icon: "compare_arrows", show: hasGaugeParts },
  { id: "maintenance",      label: "Maintenance",                 icon: "handyman",       show: !!machine.maintenance?.length },
  { id: "resources",        label: "Resources",                   icon: "link",           show: !!machine.resources?.length },
  { id: "final-notes",      label: "Important Notes",             icon: "warning",        show: !!machine.finalNotes && !isIncomplete },
].filter(s => s.show);

const formattedDate = machine.publishedDate
  ? new Date(machine.publishedDate).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
  : "";
---

<BaseLayout title={machine.title} description={machine.subtitle || machine.overviewDescription?.slice(0, 160)}>
  <Navbar currentPage="specs" />

  <div style="background:#f0f1f1; min-height:calc(100vh - 56px);">
    <div style="max-width:1280px; margin:0 auto; padding:12px 12px 48px; display:flex; gap:16px; align-items:flex-start;">

      <aside id="detail-sidebar" style="width:180px; flex-shrink:0; position:sticky; top:68px; display:flex; flex-direction:column; gap:10px;">
        <div style="background:#0f1111; border-radius:8px; padding:14px 0; overflow:hidden;">
          <div style="font-size:9px; font-weight:700; color:#666; font-family:'Inter',sans-serif; letter-spacing:0.1em; text-transform:uppercase; padding:0 14px 10px; border-bottom:1px solid #2a2a2a; margin-bottom:6px;">
            CONTENTS
          </div>
          {machine.youtubeVideoId && (
            <a href="#video" data-section="video" class="sidebar-link"
              style="display:flex; align-items:center; gap:7px; font-size:11px; color:#888; font-family:'Inter',sans-serif; padding:6px 14px; text-decoration:none; border-left:2px solid transparent; transition:all 0.15s; line-height:1.3;">
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:13px; flex-shrink:0;">play_circle</span>
              Watch Video
            </a>
          )}
          {sections.map(s => (
            <a href={`#${s.id}`} data-section={s.id} class="sidebar-link"
              style="display:flex; align-items:center; gap:7px; font-size:11px; color:#888; font-family:'Inter',sans-serif; padding:6px 14px; text-decoration:none; border-left:2px solid transparent; transition:all 0.15s; line-height:1.3;">
              <span class="material-symbols-outlined notranslate" translate="no" style="font-size:13px; flex-shrink:0;">{s.icon}</span>
              {s.label}
            </a>
          ))}
        </div>
        {machine.reportDownloadUrl && (
          <a href={machine.reportDownloadUrl} target="_blank" rel="noopener noreferrer"
            style="display:flex; align-items:center; justify-content:center; gap:6px; background:#ff9900; color:#0f1111; font-size:11px; font-weight:700; font-family:'Inter',sans-serif; padding:10px; border-radius:8px; text-decoration:none;">
            <span class="material-symbols-outlined notranslate" translate="no" style="font-size:15px;">download</span>
            Download Report
          </a>
        )}
      </aside>

      <main style="flex:1; min-width:0; display:flex; flex-direction:column; gap:10px;">

        <a href={homeHref} style="display:inline-flex; align-items:center; gap:4px; font-size:11px; color:#565959; font-family:'Inter',sans-serif; text-decoration:none; margin-bottom:2px; width:fit-content;"
          onmouseover="this.style.color='#ff9900'" onmouseout="this.style.color='#565959'">
          <span class="material-symbols-outlined notranslate" translate="no" style="font-size:13px;">arrow_back</span>
          Back to Directory
        </a>

        <div style="background:#fff; border:1px solid #e3e6e6; border-radius:8px; padding:16px 20px; display:flex; gap:20px; align-items:flex-start;">
          {machineImageSrc && (
            <div style="width:400px; height:300px; flex-shrink:0; background:#f7f8f8; border:1px solid #e3e6e6; border-radius:6px; overflow:hidden; display:flex; align-items:center; justify-content:center;">
              <img src={machineImageSrc} alt={machine.title} style="width:100%; height:100%; object-fit:contain; mix-blend-mode:multiply; padding:8px;" />
            </div>
          )}
          <div style="flex:1; min-width:0; display:flex; flex-direction:column; gap:10px;">
            <div>
              <h1 style="margin:0 0 4px; font-size:20px; font-weight:800; color:#0f1111; font-family:'Inter',sans-serif; line-height:1.2;">{machine.title}</h1>
              {machine.subtitle && <p style="margin:0 0 8px; font-size:12px; color:#565959; font-family:'Inter',sans-serif; line-height:1.4;">{machine.subtitle}</p>}
              <div style="display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                {machine.brand && <span style="background:#0f1111; color:#ff9900; font-size:10px; font-weight:700; font-family:'Inter',sans-serif; padding:3px 10px; border-radius:4px;"><span class="brand-text notranslate" translate="no" data-brand={machine.brand}>{machine.brand}</span></span>}
                {machine.category && <span style="background:#f0f2f2; color:#565959; font-size:10px; font-family:'Inter',sans-serif; padding:3px 10px; border-radius:4px; border:1px solid #e3e6e6;">{machine.category}</span>}
                {formattedDate && <span style="display:inline-flex; align-items:center; gap:3px; font-size:10px; color:#888; font-family:'Inter',sans-serif;"><span class="material-symbols-outlined notranslate" translate="no" style="font-size:12px;">calendar_today</span>{formattedDate}</span>}
              </div>
            </div>
            {(machine.technicalSpecs?.length || machine.classificationTable?.length) && (
              <div style="border-top:1px solid #f0f0f0; padding-top:10px;">
                <KeySpecsGrid machine={machine} />
              </div>
            )}
          </div>
        </div>

        {machine.youtubeVideoId && (
          <SectionCard id="video" title="Watch Video" icon="play_circle">
            <YouTubeEmbed videoId={machine.youtubeVideoId} title={`${machine.title} — Demo Video`} />
          </SectionCard>
        )}

        {sections.map(s => (
          <SectionCard id={s.id} title={s.label} icon={s.icon}>
            {s.id === "purpose" && machine.purposeAndApplication && (
              <div style="display:flex; flex-direction:column; gap:14px;">
                <div>
                  <div style="font-size:10px; font-weight:700; color:#ff9900; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:5px;">What is it for?</div>
                  <p style="margin:0; font-size:12px; color:#333; font-family:'Inter',sans-serif; line-height:1.6;">{machine.purposeAndApplication.purpose}</p>
                </div>
                <div>
                  <div style="font-size:10px; font-weight:700; color:#ff9900; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.06em; margin-bottom:7px;">Key Applications</div>
                  <ul style="margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:4px;">
                    {machine.purposeAndApplication.applications.map((app: string) => (
                      <li style="display:flex; align-items:flex-start; gap:7px; font-size:12px; color:#333; font-family:'Inter',sans-serif; line-height:1.5;">
                        <span style="color:#ff9900; font-weight:700; flex-shrink:0;">•</span>{app}
                      </li>
                    ))}
                  </ul>
                </div>
                <div style="background:#f7f8f8; border:1px solid #e3e6e6; border-radius:6px; padding:9px 13px; display:flex; align-items:flex-start; gap:7px;">
                  <span class="material-symbols-outlined notranslate" translate="no" style="font-size:14px; color:#ff9900; flex-shrink:0; margin-top:1px;">factory</span>
                  <div>
                    <span style="font-size:9px; font-weight:700; color:#999; font-family:'Inter',sans-serif; text-transform:uppercase; letter-spacing:0.06em; display:block; margin-bottom:2px;">Industry</span>
                    <span style="font-size:12px; color:#333; font-family:'Inter',sans-serif;">{machine.purposeAndApplication.industry}</span>
                  </div>
                </div>
              </div>
            )}

            {s.id === "overview" && (
              <>
                {machine.overviewDescription && (
                  <p style="margin:0 0 14px; font-size:12px; color:#333; font-family:'Inter',sans-serif; line-height:1.6;">{machine.overviewDescription}</p>
                )}
                {machine.classificationTable?.length > 0 && (
                  <table style="width:100%; border-collapse:collapse; font-size:12px; font-family:'Inter',sans-serif;">
                    <thead>
                      <tr style="background:#0f1111;">
                        <th style="padding:8px 12px; text-align:left; font-weight:600; color:#ff9900; border-bottom:1px solid #2a2a2a; width:35%; font-size:11px;">Field</th>
                        <th style="padding:8px 12px; text-align:left; font-weight:600; color:#aaa; border-bottom:1px solid #2a2a2a; font-size:11px;">Information</th>
                      </tr>
                    </thead>
                    <tbody>
                      {machine.classificationTable.map((row: any, i: number) => (
                        <tr style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
                          <td style="padding:7px 12px; font-weight:600; color:#0f1111; border-bottom:1px solid #f0f0f0;">{row.field}</td>
                          <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0;">{row.value}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </>
            )}

            {s.id === "technical-data" && machine.technicalSpecs?.length > 0 && (
              <>
                <SpecTable specs={machine.technicalSpecs} />
                {isIncomplete && (
                  <div
                    id="more-info-coming-soon"
                    style="margin:24px auto 8px; padding:32px 28px;
                           max-width:760px; width:100%;
                           background:#fff5f5; border:2px solid #dc2626;
                           border-radius:10px;
                           display:flex; flex-direction:column; align-items:center; gap:14px;
                           text-align:center;
                           font-family:'Inter',sans-serif;
                           box-shadow:0 4px 14px rgba(220,38,38,0.15);"
                  >
                    <span class="material-symbols-outlined notranslate" translate="no"
                          style="font-size:42px; color:#dc2626; flex-shrink:0;">
                      hourglass_top
                    </span>
                    <div style="font-size:22px; font-weight:800; color:#b91c1c;
                                text-transform:uppercase; letter-spacing:0.08em;
                                line-height:1.2;">
                      More Information<br/>Coming Soon
                    </div>
                    <div style="font-size:14px; font-weight:600; color:#7f1d1d; line-height:1.5;
                                max-width:560px;">
                      This machine's documentation is still being compiled.
                      Working principles, sequence flow, parts list, maintenance,
                      and resources will be added shortly.
                    </div>
                    <div style="font-size:12px; font-weight:600; color:#991b1b;
                                padding:5px 12px; background:#fee2e2; border-radius:999px;
                                text-transform:uppercase; letter-spacing:0.06em;">
                      ⚠ Incomplete Page
                    </div>
                  </div>
                )}
              </>
            )}

            {s.id === "working-principle" && machine.workingPrinciples?.length > 0 && (
              <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:10px;">
                {machine.workingPrinciples.map((p: any) => (
                  <div style="background:#f7f8f8; border:1px solid #e3e6e6; border-radius:6px; padding:12px 14px; border-left:3px solid #ff9900;">
                    <div style="font-size:12px; font-weight:700; color:#0f1111; font-family:'Inter',sans-serif; margin-bottom:5px;">{p.heading}</div>
                    <div style="font-size:12px; color:#565959; font-family:'Inter',sans-serif; line-height:1.5;">{p.description}</div>
                    {Array.isArray(p.componentIds) && p.componentIds.length > 0 && (
                      <div style="margin-top:8px; padding-top:8px; border-top:1px dashed #e3e6e6; display:flex; flex-wrap:wrap; gap:4px; align-items:center;">
                        <span style="font-size:9px; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:0.05em; font-family:'Inter',sans-serif;">Components:</span>
                        {p.componentIds.map((id: string) => (
                          <span style="background:#0f1111; color:#ff9900; font-size:10px; font-weight:600; font-family:'JetBrains Mono',monospace; padding:2px 6px; border-radius:3px;">{id}</span>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}

            {s.id === "sequence-flow" && machine.sequenceFlow?.length > 0 && (
              <SequenceFlow steps={machine.sequenceFlow} />
            )}

            {s.id === "parts-list" && machine.partsList?.length > 0 && (
              <PartsTable parts={machine.partsList} brand={machine.brand} category={machine.category} partsMeta={machine.partsMeta} />
            )}

            {s.id === "gauge-parts" && hasGaugeParts && (
              <>
                <div style="font-size:11px; color:#888; font-family:'Inter',sans-serif; margin-bottom:10px;">Quick lookup table for gauge-specific components.</div>
                <table style="width:100%; border-collapse:collapse; font-size:12px; font-family:'Inter',sans-serif;">
                  <thead>
                    <tr style="background:#0f1111;">
                      <th style="padding:8px 12px; text-align:left; font-weight:600; color:#ff9900; border-bottom:1px solid #2a2a2a; font-size:11px;">Gauge Code</th>
                      <th style="padding:8px 12px; text-align:left; font-weight:600; color:#aaa; border-bottom:1px solid #2a2a2a; font-size:11px;">Description</th>
                      <th style="padding:8px 12px; text-align:left; font-weight:600; color:#aaa; border-bottom:1px solid #2a2a2a; font-size:11px;">Needles</th>
                      <th style="padding:8px 12px; text-align:left; font-weight:600; color:#aaa; border-bottom:1px solid #2a2a2a; font-size:11px;">Needle Gauge</th>
                      <th style="padding:8px 12px; text-align:left; font-weight:600; color:#aaa; border-bottom:1px solid #2a2a2a; font-size:11px;">Presser Foot</th>
                      <th style="padding:8px 12px; text-align:left; font-weight:600; color:#aaa; border-bottom:1px solid #2a2a2a; font-size:11px;">Feed Dog</th>
                    </tr>
                  </thead>
                  <tbody>
                    {machine.gaugePartsCrossReference.map((g: any, i: number) => (
                      <tr style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
                        <td style="padding:7px 12px; font-weight:700; color:#c0392b; border-bottom:1px solid #f0f0f0; font-family:'JetBrains Mono',monospace; font-size:11px;">{g.gaugeCode}</td>
                        <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0;">{g.description}</td>
                        <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0;">{g.needles}</td>
                        <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0;">{g.needleGauge}</td>
                        <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0;">{g.presserFoot}</td>
                        <td style="padding:7px 12px; color:#333; border-bottom:1px solid #f0f0f0;">{g.feedDog}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </>
            )}

            {s.id === "maintenance" && machine.maintenance?.length > 0 && (
              <MaintenanceTable items={machine.maintenance} />
            )}

            {s.id === "resources" && machine.resources?.length > 0 && (
              <table style="width:100%; border-collapse:collapse; font-size:12px; font-family:'Inter',sans-serif;">
                <thead>
                  <tr style="background:#f7f8f8;">
                    <th style="padding:8px 16px; text-align:left; font-weight:600; color:#565959; border-bottom:1px solid #e3e6e6;">Resource</th>
                    <th style="padding:8px 16px; text-align:left; font-weight:600; color:#565959; border-bottom:1px solid #e3e6e6;">Description</th>
                    <th style="padding:8px 16px; text-align:left; font-weight:600; color:#565959; border-bottom:1px solid #e3e6e6; width:70px;">Link</th>
                  </tr>
                </thead>
                <tbody>
                  {machine.resources.map((r: any, i: number) => (
                    <tr style={i % 2 === 0 ? "background:#fff;" : "background:#fafafa;"}>
                      <td style="padding:7px 16px; font-weight:600; color:#0f1111; border-bottom:1px solid #f0f0f0;">{r.resourceName}</td>
                      <td style="padding:7px 16px; color:#565959; border-bottom:1px solid #f0f0f0;">{r.description}</td>
                      <td style="padding:7px 16px; border-bottom:1px solid #f0f0f0;">
                        {r.url ? (
                          <a href={r.url} target="_blank" rel="noopener noreferrer"
                            style="color:#ff9900; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:3px;"
                            onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                            Open <span class="material-symbols-outlined notranslate" translate="no" style="font-size:12px;">open_in_new</span>
                          </a>
                        ) : "—"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}

            {s.id === "final-notes" && machine.finalNotes && (
              <div style="margin:0; padding:12px 16px; border-left:3px solid #ff9900; background:#fffbf2; border-radius:0 4px 4px 0;">
                <p style="margin:0; font-size:12px; color:#333; font-family:'Inter',sans-serif; line-height:1.7; white-space:pre-line;">{machine.finalNotes}</p>
              </div>
            )}
          </SectionCard>
        ))}

        <RelatedMachines
          currentSlug={Astro.params.slug}
          currentBrand={machine.brand || ""}
          currentCategory={machine.category || ""}
          machines={allMachines}
        />

      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  const links = document.querySelectorAll(".sidebar-link");
  const sectionEls = Array.from(document.querySelectorAll("section[id]"));

  function setActive(id: string) {
    links.forEach(link => {
      const isActive = link.dataset.section === id;
      link.style.color = isActive ? "#ff9900" : "#888";
      link.style.borderLeftColor = isActive ? "#ff9900" : "transparent";
      link.style.fontWeight = isActive ? "600" : "400";
      link.style.backgroundColor = isActive ? "rgba(255,153,0,0.08)" : "";
    });
  }

  function getActiveSection(): string {
    const scrollY = window.scrollY + 80;
    let current = sectionEls[0]?.id || "";
    for (const section of sectionEls) {
      if (section.offsetTop <= scrollY) {
        current = section.id;
      }
    }
    return current;
  }

  window.addEventListener("scroll", () => {
    setActive(getActiveSection());
  }, { passive: true });

  setActive(getActiveSection());

  links.forEach(link => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const id = link.dataset.section;
      if (!id) return;
      const target = document.getElementById(id);
      if (target) {
        const top = target.getBoundingClientRect().top + window.scrollY - 72;
        window.scrollTo({ top, behavior: "smooth" });
        setActive(id);
      }
    });
  });
</script>
