---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Sidebar from "../../components/Sidebar.astro";
import SpecTable from "../../components/SpecTable.astro";
import SequenceFlow from "../../components/SequenceFlow.astro";
import PartsTable from "../../components/PartsTable.astro";
import MaintenanceTable from "../../components/MaintenanceTable.astro";
import fs from "node:fs";
import path from "node:path";

// ─── Generate static paths ───
export function getStaticPaths() {
  const machinesDir = path.join(process.cwd(), "src/content/machines");
  if (!fs.existsSync(machinesDir)) return [];

  const files = fs.readdirSync(machinesDir).filter((f: string) => f.endsWith(".json"));
  return files.map((file: string) => {
    const raw = fs.readFileSync(path.join(machinesDir, file), "utf-8");
    const data = JSON.parse(raw);
    return {
      params: { slug: file.replace(".json", "") },
      props: { machine: data },
    };
  });
}

const { machine } = Astro.props;

// ─── Build sidebar sections ───
const sidebarSections = [
  { id: "overview", label: "Overview" },
  ...(machine.technicalSpecs?.length ? [{ id: "technical-data", label: "Technical Data" }] : []),
  ...(machine.workingPrinciples?.length
    ? [{ id: "working-principle", label: "Working Principle" }]
    : []),
  ...(machine.sequenceFlow?.length
    ? [{ id: "sequence-flow", label: "Sequence Flow" }]
    : []),
  ...(machine.partsList?.length ? [{ id: "parts-list", label: "Parts List" }] : []),
  ...(machine.maintenance?.length
    ? [{ id: "maintenance", label: "Maintenance" }]
    : []),
  ...(machine.resources?.length ? [{ id: "resources", label: "Resources" }] : []),
  ...(machine.finalNotes ? [{ id: "final-notes", label: "Final Notes" }] : []),
];
---

<BaseLayout
  title={machine.title}
  description={machine.subtitle || machine.overviewDescription?.slice(0, 160)}
>
  <Navbar currentPage="specs" />

  <div class="w-full max-w-7xl mx-auto px-5 md:px-16 py-12 flex flex-col md:flex-row gap-20 items-start">
    <Sidebar
      sections={sidebarSections}
      downloadUrl={machine.reportDownloadUrl}
    />

    <main class="flex-grow flex flex-col gap-20 w-full min-w-0">
      <!-- Header -->
      <header class="flex flex-col gap-6 animate-fade-in">
        <div>
          <a
            href="/Machines/"
            class="inline-flex items-center gap-1 text-body-sm mb-4 transition-colors hover:underline"
            style="color: var(--color-primary);"
          >
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to Directory
          </a>
          <h1 class="text-display-xl" style="color: var(--color-primary);">
            {machine.title}
          </h1>
          {machine.subtitle && (
            <p class="text-headline-lg" style="color: var(--color-on-surface-variant);">
              {machine.subtitle}
            </p>
          )}
        </div>

        {machine.machineImage && (
          <div
            class="w-full h-[400px] rounded border border-outline-variant flex items-center justify-center overflow-hidden"
            style="background-color: var(--color-surface-container-high);"
          >
            <img
              alt={machine.title}
              class="w-full h-full object-contain mix-blend-multiply p-4"
              src={machine.machineImage}
            />
          </div>
        )}
      </header>

      <!-- Overview Section -->
      <section class="flex flex-col gap-6 scroll-mt-24 animate-slide-up" id="overview">
        <h2
          class="text-headline-md border-b border-outline-variant pb-1"
          style="color: var(--color-primary);"
        >
          Machine Overview
        </h2>

        {machine.overviewDescription && (
          <p class="text-body-lg" style="color: var(--color-on-surface);">
            {machine.overviewDescription}
          </p>
        )}

        {machine.classificationTable?.length > 0 && (
          <div class="bg-surface-container-lowest border border-outline-variant rounded overflow-hidden">
            <table class="w-full text-left border-collapse">
              <thead style="background-color: var(--color-secondary);">
                <tr>
                  <th class="p-4 border-b border-outline-variant w-1/3 text-label-caps" style="color: var(--color-on-primary);">
                    Field
                  </th>
                  <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-primary);">
                    Information
                  </th>
                </tr>
              </thead>
              <tbody class="text-body-md" style="color: var(--color-on-surface);">
                {machine.classificationTable.map((row: any, i: number) => (
                  <tr
                    class="border-b border-outline-variant"
                    style={i % 2 === 0 ? "background-color: var(--color-surface-container-lowest);" : "background-color: var(--color-surface-container);"}
                  >
                    <td class="p-4 font-semibold">{row.field}</td>
                    <td class="p-4">{row.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <!-- Technical Data -->
      {machine.technicalSpecs?.length > 0 && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="technical-data">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Technical Data
          </h2>
          <SpecTable specs={machine.technicalSpecs} />
        </section>
      )}

      <!-- Working Principle -->
      {machine.workingPrinciples?.length > 0 && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="working-principle">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Working Principle
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {machine.workingPrinciples.map((principle: any) => (
              <div
                class="p-6 rounded border border-outline-variant"
                style="background-color: var(--color-surface-container-low);"
              >
                <h3 class="text-headline-md mb-3" style="color: var(--color-secondary);">
                  {principle.heading}
                </h3>
                <p class="text-body-md">{principle.description}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Sequence Flow -->
      {machine.sequenceFlow?.length > 0 && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="sequence-flow">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Operational Sequence
          </h2>
          <SequenceFlow steps={machine.sequenceFlow} />
        </section>
      )}

      <!-- Parts List -->
      {machine.partsList?.length > 0 && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="parts-list">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Key Parts List
          </h2>
          <PartsTable parts={machine.partsList} />
        </section>
      )}

      <!-- Maintenance -->
      {machine.maintenance?.length > 0 && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="maintenance">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Maintenance & Troubleshooting
          </h2>
          <MaintenanceTable items={machine.maintenance} />
        </section>
      )}

      <!-- Resources -->
      {machine.resources?.length > 0 && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="resources">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Additional Resources
          </h2>
          <div class="bg-surface-container-lowest border border-outline-variant rounded overflow-hidden">
            <table class="w-full text-left border-collapse">
              <thead style="background-color: var(--color-surface-container);">
                <tr>
                  <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-surface-variant);">
                    Resource
                  </th>
                  <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-surface-variant);">
                    Description
                  </th>
                  <th class="p-4 border-b border-outline-variant text-label-caps" style="color: var(--color-on-surface-variant);">
                    Link
                  </th>
                </tr>
              </thead>
              <tbody class="text-body-md" style="color: var(--color-on-surface);">
                {machine.resources.map((resource: any, i: number) => (
                  <tr
                    class="border-b border-outline-variant"
                    style={i % 2 === 0 ? "background-color: var(--color-surface-container-lowest);" : "background-color: var(--color-surface-container);"}
                  >
                    <td class="p-4 font-semibold">{resource.resourceName}</td>
                    <td class="p-4" style="color: var(--color-on-surface-variant);">
                      {resource.description}
                    </td>
                    <td class="p-4">
                      {resource.url ? (
                        <a
                          href={resource.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1 text-body-sm transition-colors hover:underline"
                          style="color: var(--color-primary);"
                        >
                          Visit
                          <span class="material-symbols-outlined text-sm">open_in_new</span>
                        </a>
                      ) : (
                        "—"
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Final Notes -->
      {machine.finalNotes && (
        <section class="flex flex-col gap-6 scroll-mt-24" id="final-notes">
          <h2
            class="text-headline-md border-b border-outline-variant pb-1"
            style="color: var(--color-primary);"
          >
            Important Notes
          </h2>
          <div
            class="p-6 rounded border-l-4"
            style="background-color: var(--color-surface-container-low); border-color: var(--color-tertiary);"
          >
            <p class="text-body-md whitespace-pre-line">{machine.finalNotes}</p>
          </div>
        </section>
      )}

      <!-- Mobile Download Button -->
      {machine.reportDownloadUrl && (
        <div class="flex justify-center mt-4 mb-12 md:hidden">
          <a
            class="w-full text-headline-md font-bold px-8 py-4 rounded flex items-center justify-center gap-3 transition-colors hover:opacity-90 shadow-sm"
            style="background-color: var(--color-primary); color: var(--color-on-primary);"
            href={machine.reportDownloadUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined">download</span>
            DOWNLOAD REPORT
          </a>
        </div>
      )}
    </main>
  </div>

  <Footer />
</BaseLayout>
