{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine Schema",
  "description": "Schema for industrial sewing machine entries on Southern Machines website",
  "type": "object",
  "required": ["title", "brand", "category", "purposeAndApplication"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Full machine name and model number (e.g., 'Brother DA-927A')"
    },
    "subtitle": {
      "type": "string",
      "description": "Subtitle or full descriptive name"
    },
    "brand": {
      "type": "string",
      "description": "Manufacturer brand name (e.g., 'Brother', 'JUKI', 'Zoje')"
    },
    "category": {
      "type": "string",
      "description": "Machine category (e.g., 'Chain Stitch Machine', 'Overlock Machine')"
    },
    "machineImage": {
      "type": "string",
      "description": "URL or path to machine image. Leave empty initially.",
      "default": ""
    },
    "reportDownloadUrl": {
      "type": "string",
      "description": "URL to downloadable PDF manual/report. Leave empty initially.",
      "default": ""
    },
    "publishedDate": {
      "type": "string",
      "format": "date-time",
      "description": "Publication date in ISO 8601 format (e.g., '2025-01-15T00:00:00.000Z')"
    },
    "purposeAndApplication": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "description": "Primary purpose of the machine"
        },
        "applications": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of specific applications"
        },
        "industry": {
          "type": "string",
          "description": "Target industry (e.g., 'Textile', 'Automotive')"
        }
      },
      "required": ["purpose", "applications", "industry"]
    },
    "overviewDescription": {
      "type": "string",
      "description": "General overview and description of the machine"
    },
    "classificationTable": {
      "type": "array",
      "description": "Classification/specification key-value pairs",
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["field", "value"]
      }
    },
    "technicalSpecs": {
      "type": "array",
      "description": "Technical specifications table",
      "items": {
        "type": "object",
        "properties": {
          "parameter": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["parameter", "value"]
      }
    },
    "workingPrinciples": {
      "type": "array",
      "description": "How the machine works",
      "items": {
        "type": "object",
        "properties": {
          "heading": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["heading", "description"]
      }
    },
    "sequenceFlow": {
      "type": "array",
      "description": "Step-by-step operation sequence",
      "items": {
        "type": "object",
        "properties": {
          "stepTitle": { "type": "string" },
          "stepDescription": { "type": "string" }
        },
        "required": ["stepTitle", "stepDescription"]
      }
    },
    "partsList": {
      "type": "array",
      "description": "List of machine parts with IDs and functions",
      "items": {
        "type": "object",
        "properties": {
          "partName": { "type": "string" },
          "partId": { "type": "string" },
          "function": { "type": "string" }
        },
        "required": ["partName", "partId", "function"]
      }
    },
    "gaugePartsCrossReference": {
      "type": "array",
      "description": "Gauge and needle cross-reference data",
      "items": {
        "type": "object",
        "properties": {
          "gaugeCode": { "type": "string" },
          "description": { "type": "string" },
          "needles": { "type": "string" },
          "needleGauge": { "type": "string" },
          "presserFoot": { "type": "string" },
          "feedDog": { "type": "string" }
        },
        "required": ["gaugeCode", "description"]
      }
    },
    "maintenance": {
      "type": "array",
      "description": "Maintenance codes and troubleshooting",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "definition": { "type": "string" },
          "action": { "type": "string" }
        },
        "required": ["code", "definition", "action"]
      }
    },
    "resources": {
      "type": "array",
      "description": "External resources and references",
      "items": {
        "type": "object",
        "properties": {
          "resourceName": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["resourceName", "description"]
      }
    },
    "finalNotes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Important notes, warnings, and tips"
    }
  }
}
